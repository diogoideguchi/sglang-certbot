# Token de API Cloudflare (conta própria, domínio do cert) com permissão
# Zone:DNS:Edit na zona do domínio. Configurar como RunPod Secret
# ({{ RUNPOD_SECRET_cloudflare_api_token }}), não em texto puro.
CLOUDFLARE_API_TOKEN=

# FQDN completo do certificado/A record (ex. sglang.seu-dominio.com).
SGLANG_TLS_DOMAIN=

# Email de contato pro Let's Encrypt (avisos de expiração).
CERTBOT_EMAIL=

# Porta interna do SGLang — usada só pra logar a porta pública atual
# (lida de RUNPOD_TCP_PORT_<essa porta>, auto-injetada pela RunPod).
# Recomendado usar valor >= 70000 pra porta externa fixa/previsível
# (symmetrical port mapping da RunPod) em vez de aleatória a cada restart.
SGLANG_CONTAINER_PORT=8000

# Override do zone ID da Cloudflare — só necessário se SGLANG_TLS_DOMAIN
# tiver mais de 2 níveis (ex. sub.dom.example.com), onde a detecção
# automática (2 últimos labels do domínio) pode ser ambígua.
#CLOUDFLARE_ZONE_ID=

# Diretório persistente (volume RunPod, /workspace por padrão) onde ficam
# config/work/logs do certbot + cloudflare.ini.
CERT_PERSIST_DIR=/workspace/certbot

# Intervalo do loop de renovação em background, em segundos.
CERT_RENEW_INTERVAL_SECONDS=43200
